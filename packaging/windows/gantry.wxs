<!-- The Windows installer (WiX 5), built by build.ps1. Installs for the current user only (no administrator rights),
     into %LOCALAPPDATA%\Programs\Gantry, with a Start menu shortcut and the folder on the user's PATH. Files in the
     user profile need a registry key path per component and their folders removed on uninstall (ICE38, ICE64). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Keep UpgradeCode fixed forever: it is how a newer installer finds and replaces an older one. -->
  <Package Name="Gantry" Manufacturer="Gantry" Version="$(Version)" UpgradeCode="3dfad8ff-e06c-4812-8afb-351857d8b2c6"
           Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Gantry is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="GantryIcon" SourceFile="$(Stage)\gantry.ico" />
    <Property Id="ARPPRODUCTICON" Value="GantryIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/idogrf/gantry" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Gantry">
          <Directory Id="LicensesFolder" Name="licenses" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- gantryd: Gantry without its window, which prints its version in a terminal (gantry.exe has no console). -->
    <Component Id="Binaries" Directory="INSTALLFOLDER" Guid="9a3c6f1e-2b7d-4c58-8e41-6d0f2a9b7c35">
      <File Source="$(Stage)\gantry.exe" />
      <File Source="$(Stage)\gantryd.exe" />
      <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <!-- Only removed when empty: other per-user apps install beside Gantry. -->
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Gantry" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="Licenses" Directory="LicensesFolder" Guid="c4e8b2d7-5f19-4a63-b0d2-8e7a1f3c6b94">
      <File Source="$(Stage)\LICENSE-MIT" />
      <File Source="$(Stage)\LICENSE-APACHE" />
      <File Source="$(Stage)\NOTICE" />
      <File Source="$(Stage)\THIRD_PARTY_LICENSES.html" />
      <File Source="$(Stage)\LICENSE-FONT-FIGTREE" />
      <RemoveFolder Id="RemoveLicensesFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Gantry" Name="Licenses" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="5d0c8a3e-7f2b-4b8e-a6d1-2c9e4f7b3a10">
        <Shortcut Id="GantryShortcut" Name="Gantry" Description="A terminal for Claude Code sessions"
                  Target="[INSTALLFOLDER]gantry.exe" WorkingDirectory="INSTALLFOLDER" Icon="GantryIcon">
          <!-- Notifications show under this id (the app registers the same one, see alerts.rs). -->
          <ShortcutProperty Key="System.AppUserModel.ID" Value="io.github.idogrf.Gantry" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Gantry" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentRef Id="Binaries" />
      <ComponentRef Id="Licenses" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
